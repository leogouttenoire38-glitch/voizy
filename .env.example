[TEMPLATE]
# ===========================================================================
# Voizy — variables d'environnement (à copier dans .env et remplir)
# ===========================================================================

# --- Supabase (projet cloud) -------------------------------------------------
# Depuis Project Settings → API : https://<ref>.supabase.co + anon key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service role key — SECRET : uniquement serveur / fonctions. Jamais dans l'app.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Secrets Edge Functions (supabase secrets set --env-file .env) -----------
# Stripe (test mode : sk_test_... / whsec_...)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur

# Expo Notifications (optionnel — access token du projet Expo)
EXPO_ACCESS_TOKEN=

# --- Mobile (Expo) -----------------------------------------------------------
# Lues côté client via process.env.EXPO_PUBLIC_* — jamais de secret ici !
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...