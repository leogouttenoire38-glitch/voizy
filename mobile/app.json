{
  "expo": {
    "name": "Voizy",
    "slug": "voizy",
    "owner": "adnchaoss-team",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voizy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.voizy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Voizy a besoin de votre position pour trouver les commerçants et commandes groupées autour de chez vous."
      }
    },
    "android": {
      "package": "com.voizy.app",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Voizy a besoin de votre position pour trouver les commerçants et commandes autour de chez vous."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2848eb08-8d5e-4dfe-8f3c-d7a674113067"
      }
    }
  }
}
