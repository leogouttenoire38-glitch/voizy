# Voizy mobile — variables lues par Expo au build (préfixe EXPO_PUBLIC_).
# Copier ce fichier vers mobile/.env et renseigner les valeurs du projet Supabase.
# Jamais de secret ici : uniquement l'URL et la clé anon.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...